# Environment Variables
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# Google Gemini API Key (Primary AI)
# Get your keys at: https://aistudio.google.com/apikey
# You can provide multiple keys separated by commas for automatic fallback when quotas are exhausted.
VITE_GEMINI_API_KEY=key_1_here,key_2_here

# Groq API Key (Fallback #1 — Llama 3.3 70B)
# Get free key at: https://console.groq.com
VITE_GROQ_API_KEY=your_groq_key_here

# OpenRouter API Key (Fallback #2 — Qwen 3 235B)
# Get free key at: https://openrouter.ai/keys
# Free models available: qwen/qwen3-235b-a22b:free
VITE_OPENROUTER_API_KEY=your_openrouter_key_here
