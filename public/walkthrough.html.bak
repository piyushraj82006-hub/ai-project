    <!-- STEP 13: Logout -->
    <div class="step" data-step="13">
      <div class="step-text">
        <div class="step-number" style="background: rgba(244, 67, 54, 0.15); color: var(--red);">13</div>
        <h3>Secure Logout</h3>
        <div class="subtitle">Session Termination</div>
        <p>
          The logout flow clears the user session from localStorage, notifies all auth listeners,
          and redirects to the login page. Protected routes automatically redirect unauthenticated
          users, ensuring security.
