rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ───
    // Only the authenticated owner can read/write their own doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Deadlines subcollection
      match /deadlines/{deadlineId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ─── Courses ───
    // Any authenticated user can read courses
    match /courses/{courseCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── Branches ───
    match /branches/{branchCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── PYQs ───
    // Any authenticated user can read PYQs
    // Any authenticated user can create PYQs (community uploads)
    match /pyqs/{pyqId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
