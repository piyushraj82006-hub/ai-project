    <!-- STEP 6: Summary -->
    <div class="step" data-step="6">
      <div class="step-text">
        <div class="step-number" style="background: rgba(78, 205, 196, 0.15); color: var(--cyan);">06</div>
        <h3>Summary View</h3>
        <div class="subtitle">Structured AI Document Analysis</div>
        <p>
          The Summary tab presents a richly structured breakdown of the document including
          overview, course objectives, modules, key concepts, insights, and references.
          Content supports Markdown rendering with LaTeX math via KaTeX.
        </p>
        <ul class="step-features">
          <li>Document title and overview extraction</li>
          <li>Module-by-module breakdown with topics</li>
          <li>Key concepts with definitions</li>
          <li>Key insights and actionable takeaways</li>
          <li>References and metadata extraction</li>
        </ul>
      </div>
      <div class="step-media">
