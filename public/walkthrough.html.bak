  <!-- ═══════ SCROLL ANIMATIONS + CINEMA ═══════ -->
  <script>
    // Scroll reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.step').forEach(step => observer.observe(step));

    // ─── Screenshot Cinema Player ───
    (function() {
      const screenshots = [
        { file: '01_login_page.png', title: 'Step 1: Login Page' },
        { file: '02_login_filled.png', title: 'Step 1: Credentials Entered' },
        { file: '03_password_visible.png', title: 'Step 1: Password Toggle' },
        { file: '04_after_login.png', title: 'Step 1: Login Submitted' },
        { file: '05_dashboard.png', title: 'Step 2: Dashboard' },
        { file: '06_dashboard_card_1.png', title: 'Step 2: PDF Upload Card' },
        { file: '06_dashboard_card_2.png', title: 'Step 2: Text Summarizer Card' },
        { file: '06_dashboard_card_3.png', title: 'Step 2: Mind Maps Card' },
        { file: '07_dashboard_history.png', title: 'Step 2: Recent History' },
        { file: '08_pdf_upload_page.png', title: 'Step 3: PDF Upload Page' },
        { file: '09_pdf_hero.png', title: 'Step 3: Hero Section' },
        { file: '10_demo_button.png', title: 'Step 4: Demo Button' },
        { file: '11_demo_loaded.png', title: 'Step 4: Demo Loaded' },
        { file: '12_reels_view.png', title: 'Step 5: Reels View' },
        { file: '13_reels_detail.png', title: 'Step 5: Reel Detail' },
        { file: '14_summary_view.png', title: 'Step 6: Summary View' },
        { file: '15_summary_scrolled.png', title: 'Step 6: Summary Scrolled' },
        { file: '16_summary_more.png', title: 'Step 6: More Summary' },
        { file: '17_mindmap_view.png', title: 'Step 7: Mind Map' },
        { file: '18_mindmap_detail.png', title: 'Step 7: Mind Map Detail' },
        { file: '19_chat_view.png', title: 'Step 8: AI Chat' },
        { file: '20_split_layout.png', title: 'Step 9: Split Layout' },
        { file: '21_text_summarizer.png', title: 'Step 10: Text Summarizer' },
        { file: '22_text_input.png', title: 'Step 10: Text Input' },
        { file: '23_generate_button.png', title: 'Step 10: Generate Button' },
        { file: '25_back_to_dashboard.png', title: 'Step 11: Navigation' },
        { file: '26_signup_page.png', title: 'Step 12: Signup Page' },
        { file: '27_signup_filled.png', title: 'Step 12: Signup Filled' },
        { file: '28_logout_button.png', title: 'Step 13: Logout Button' },
        { file: '29_logged_out.png', title: 'Step 13: Logged Out' },
        { file: '30_walkthrough_complete.png', title: 'Walkthrough Complete' },
      ];

      let currentIdx = 0;
      let isPlaying = false;
      let intervalId = null;

      const img = document.getElementById('cinemaImg');
      const title = document.getElementById('cinemaTitle');
      const counter = document.getElementById('cinemaCounter');
      const progressFill = document.getElementById('cinemaProgressFill');
      const playBtn = document.getElementById('cinemaPlayBtn');
      const playIcon = document.getElementById('playIcon');
      const pauseIcon = document.getElementById('pauseIcon');
      const progressBar = document.getElementById('cinemaProgress');

      function showFrame(idx) {
        currentIdx = idx;
        img.src = '/selenium_screenshots/' + screenshots[idx].file;
        title.textContent = screenshots[idx].title;
        counter.textContent = (idx + 1) + ' / ' + screenshots.length;
        progressFill.style.width = ((idx + 1) / screenshots.length * 100) + '%';
      }

      function play() {
        isPlaying = true;
        playIcon.style.display = 'none';
        pauseIcon.style.display = 'block';
        intervalId = setInterval(function() {
          currentIdx++;
          if (currentIdx >= screenshots.length) {
            currentIdx = 0; // loop
          }
          showFrame(currentIdx);
        }, 2000);
      }

      function pause() {
        isPlaying = false;
        playIcon.style.display = 'block';
        pauseIcon.style.display = 'none';
        clearInterval(intervalId);
      }

      playBtn.addEventListener('click', function() {
        if (isPlaying) { pause(); } else { play(); }
      });

      progressBar.addEventListener('click', function(e) {
        const rect = progressBar.getBoundingClientRect();
        const pct = (e.clientX - rect.left) / rect.width;
        const idx = Math.floor(pct * screenshots.length);
        showFrame(Math.max(0, Math.min(idx, screenshots.length - 1)));
      });

      // Auto-play when cinema comes into view
      const cinemaObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting && !isPlaying) {
            play();
          } else if (!entry.isIntersecting && isPlaying) {
            pause();
          }
        });
      }, { threshold: 0.5 });
      cinemaObs.observe(document.getElementById('cinemaPlayer'));

      showFrame(0);
    })();
  </script>
</body>
</html>
