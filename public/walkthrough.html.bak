        <div class="img-label">14_summary_view.png — Structured AI summary output</div>
      </div>
    </div>

    <!-- STEP 7: Mind Map -->
    <div class="step" data-step="7">
      <div class="step-text">
        <div class="step-number" style="background: rgba(155, 89, 182, 0.15); color: #9B59B6;">07</div>
        <h3>Mind Map</h3>
        <div class="subtitle">Interactive D3.js Visualization</div>
        <p>
          The Mind Map tab transforms the summary into an interactive radial tree visualization
